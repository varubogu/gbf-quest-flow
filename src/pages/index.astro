---
// 通常の画面
// 下記のように URL パラメータでデータを開ける
// https://ドメイン/?d=sample
// https://ドメイン/?url=https://example.com/flow.json

import BaseLayout from '@/layouts/BaseLayout.astro';
import BodyLayout from '@/layouts/BodyLayout';
import type { ViewMode } from '@/types/types';

const mode = Astro.url.searchParams.get('mode');

// モードに応じて初期モードを設定
let initialMode: ViewMode = 'view';
if (mode === 'new') {
  initialMode = 'new';
} else if (mode === 'edit') {
  initialMode = 'edit';
}
---

<BaseLayout>
  <BodyLayout client:load initialMode={initialMode} />
</BaseLayout>
